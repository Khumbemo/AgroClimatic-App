# Copy to .streamlit/secrets.toml (never commit that file) or set the same names as environment variables.

# Optional: enables AgroBot open questions, AI design suggestions and germination interpretation.
# GEMINI_API_KEY = "..."
# GEMINI_MODEL = "gemini-flash-latest"

# Optional: one shared password for the whole app (recommended for any public deployment).
# APP_PASSWORD = "..."

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's records live under users/{uid}/{collection}/{record} and are private to them.
    match /users/{userId}/{collection}/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else, including the pre-v2 shared `nurseryBatches` collection, is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
